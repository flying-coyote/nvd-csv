# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Local scratch / clones (never commit the upstream working tree)
/tmp/
clone/
*.local

# Generated shard CSVs are published as assets on the rolling `latest` GitHub
# Release, not committed (2026-11-15: committing ~220 MB a day grew the pack to
# 1.4 GiB). data/state.json (with the per-shard SHA-256 manifest),
# data/kev_snapshot.json and data/changes/ are still committed by the workflow.
# NOTE: ignoring does not untrack the files already in the index; that takes a
# one-time `git rm --cached data/shards/*.csv`.
/data/shards/
